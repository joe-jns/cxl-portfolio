---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout
  title={`${project.title} - CXL`}
  description={`${project.format}, ${project.year}. ${project.role}.`}
>
  <article>
    <!-- project hero -->
    <section class="relative h-[100dvh] w-full overflow-hidden bg-ink">
      <canvas
        data-src={`${base}${project.image}`}
        class="gl-distort absolute inset-0 h-full w-full"
        aria-hidden="true"
      ></canvas>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-ink/10"></div>

      <div class="relative z-10 flex h-full flex-col justify-between p-6 pt-24 md:p-12 md:pt-28">
        <a href={`${base}#work`} class="font-mono text-xs uppercase tracking-[0.2em] text-bone/70 transition-colors hover:text-accent">
          Retour au travail
        </a>
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">{project.format} / {project.year}</p>
          <h1 class="mt-4 font-display text-[13vw] font-medium leading-[0.84] tracking-tighter text-bone md:text-[8vw]">
            {project.title}
          </h1>
        </div>
      </div>
    </section>

    <!-- body -->
    <section class="mx-auto max-w-[1100px] px-6 py-24 md:px-12 md:py-32">
      <div class="grid gap-12 md:grid-cols-[0.55fr_1.45fr] md:gap-20">
        <dl class="space-y-6 font-mono text-sm">
          <div><dt class="text-bone/40">Role</dt><dd class="mt-1 text-bone">{project.role}</dd></div>
          <div><dt class="text-bone/40">Format</dt><dd class="mt-1 text-bone">{project.format}</dd></div>
          <div><dt class="text-bone/40">Annee</dt><dd class="mt-1 text-bone">{project.year}</dd></div>
          <div><dt class="text-bone/40">Pour</dt><dd class="mt-1 text-bone">{project.client}</dd></div>
        </dl>
        <div class="space-y-6">
          {project.description.map((p) => (
            <p data-reveal class="max-w-[60ch] text-lg leading-relaxed text-bone/70 md:text-2xl">{p}</p>
          ))}
        </div>
      </div>

      <!-- video block (placeholder tant qu'il n'y a pas de vraie video) -->
      <div class="mt-16 aspect-video w-full overflow-hidden rounded-[10px] border border-bone/10 bg-ink-2">
        {project.videoSrc ? (
          <video class="h-full w-full object-cover" controls playsinline poster={`${base}${project.image}`}>
            <source src={project.videoSrc} type="video/mp4" />
          </video>
        ) : (
          <div class="flex h-full w-full items-center justify-center">
            <!-- TODO: integrer la vraie video (project.videoSrc) -->
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-bone/40">Video a venir</span>
          </div>
        )}
      </div>
    </section>

    <!-- prev / next -->
    <nav class="grid grid-cols-2 border-t border-bone/10 font-mono">
      <a href={`${base}projets/${prev.slug}`} class="group border-r border-bone/10 px-6 py-10 transition-colors hover:bg-ink-2 md:px-12 md:py-14">
        <span class="text-xs uppercase tracking-[0.2em] text-bone/40">Precedent</span>
        <span class="mt-2 block font-display text-2xl tracking-tight text-bone/70 transition-colors group-hover:text-bone md:text-4xl">{prev.title}</span>
      </a>
      <a href={`${base}projets/${next.slug}`} class="group px-6 py-10 text-right transition-colors hover:bg-ink-2 md:px-12 md:py-14">
        <span class="text-xs uppercase tracking-[0.2em] text-bone/40">Suivant</span>
        <span class="mt-2 block font-display text-2xl tracking-tight text-bone/70 transition-colors group-hover:text-bone md:text-4xl">{next.title}</span>
      </a>
    </nav>
  </article>
</Layout>
