---
import { site } from '../data/site';
---
<section id="contact" class="relative flex min-h-[92vh] w-full flex-col justify-between border-t border-bone/10 bg-ink px-6 py-16 md:px-12">
  <div class="flex flex-1 flex-col justify-center">
    <p class="font-mono text-xs uppercase tracking-[0.25em] text-bone/45">04:00 / Contact</p>
    <h2 class="mt-6 font-display text-[14vw] font-medium leading-[0.86] tracking-tighter text-bone md:text-[9vw]">
      Travaillons<br />ensemble<span class="text-accent">.</span>
    </h2>
    <a
      href={`mailto:${site.contact.email}`}
      class="group mt-10 inline-flex w-fit items-center gap-3 font-mono text-sm text-bone transition-colors hover:text-accent"
    >
      <span class="h-2 w-2 rounded-full bg-accent"></span> La contacter
    </a>
    <div class="mt-8 flex gap-6 font-mono text-sm text-bone/50">
      <a href={site.contact.instagram} target="_blank" rel="noopener" class="transition-colors hover:text-accent">Instagram</a>
      <a href={site.contact.youtube} target="_blank" rel="noopener" class="transition-colors hover:text-accent">YouTube</a>
      <a href={`mailto:${site.contact.email}`} class="transition-colors hover:text-accent">Email</a>
    </div>
  </div>

  <footer class="flex items-center justify-between border-t border-bone/10 pt-6 font-mono text-xs text-bone/40">
    <span>{site.alias} · {site.name}</span>
    <a href="#top" class="transition-colors hover:text-accent">Rewind</a>
  </footer>
</section>
